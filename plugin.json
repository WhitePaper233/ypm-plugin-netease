  "permissions": {
    "network": [
      "interfacepc.music.163.com",
      "music.163.com"
    ]
  },
  "navigation": [
    {
      "title": "我的云盘",
      "page": "cloud"
    },
    {
      "builtin": "home"
    },
    {
      "builtin": "liked"
    },
    {
      "builtin": "savedAlbums"
    },
    {
      "title": "排行榜",
      "page": "charts"
    }
  ],
  "settings": [
    {
      "key": "quality",
      "label": "音质",
      "type": "select",
      "default": "",
      "help": "优先使用所选音质，不可用时自动降低",
      "options": [
        {
          "value": "",
          "label": "跟随播放器"
        },
        {
          "value": "standard",
          "label": "标准"
        },
        {
          "value": "high",
          "label": "高音质"
        },
        {
          "value": "lossless",
          "label": "无损"
        },
        {
          "value": "hires",
          "label": "Hi-Res"
        }
      ]
    }
  ]
}
